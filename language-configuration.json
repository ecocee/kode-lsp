{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["`", "`"]
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["`", "`"]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*//\\s*#?region",
            "end": "^\\s*//\\s*#?endregion"
        }
    },
    "wordPattern": "[^\\s{}\\[\\](),:;@!|&^~?\\-\\r\\n\\t]+",
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(pub\\s+)?(func|let|const|if|else|while|for|do|match|struct|enum|impl|trait|try|spawn|defer|import|export)\\b(.*\\[\\{]\\s*)?$",
        "decreaseIndentPattern": "^\\s*[\\}\\]]"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(?:(?:pub|priv|protected|internal)\\s+)?(?:async\\s+)?(?:func|let|const|if|else\\s+if|else|while|for|do|match|struct|enum|impl|trait|try|catch|finally|spawn|defer|import|export)\\b.*[\\{]\\s*$",
            "afterText": "^\\s*[\\}]",
            "action": {
                "indent": "indent"
            }
        },
        {
            "beforeText": "^\\s*\\/\\*",
            "afterText": "\\*\\/",
            "action": {
                "indent": "indent"
            }
        }
    ]
}