{
	"Function": {
		"prefix": "func",
		"body": [
			"func ${1:name}(${2:params}) -> ${3:returnType} {",
			"\t${0}",
			"}"
		],
		"description": "Define a function"
	},
	"Main Function": {
		"prefix": "main",
		"body": [
			"func main() {",
			"\t${0}",
			"}"
		],
		"description": "Define main function"
	},
	"Generic Function": {
		"prefix": "funcg",
		"body": [
			"func ${1:name}<${2:T}>(${3:params}) -> ${4:returnType} {",
			"\t${0}",
			"}"
		],
		"description": "Define a generic function"
	},
	"If Statement": {
		"prefix": "if",
		"body": [
			"if (${1:condition}) {",
			"\t${2}",
			"}"
		],
		"description": "If statement"
	},
	"If-Else": {
		"prefix": "ifelse",
		"body": [
			"if (${1:condition}) {",
			"\t${2}",
			"} else {",
			"\t${3}",
			"}"
		],
		"description": "If-else statement"
	},
	"While Loop": {
		"prefix": "while",
		"body": [
			"while (${1:condition}) {",
			"\t${0}",
			"}"
		],
		"description": "While loop"
	},
	"For Loop": {
		"prefix": "for",
		"body": [
			"for (let ${1:i} = 0; $1 < ${2:count}; $1 = $1 + 1) {",
			"\t${0}",
			"}"
		],
		"description": "For loop"
	},
	"For-In Loop": {
		"prefix": "forin",
		"body": [
			"for (let ${1:item} in ${2:collection}) {",
			"\t${0}",
			"}"
		],
		"description": "For-in loop"
	},
	"Do-While Loop": {
		"prefix": "dowhile",
		"body": [
			"do {",
			"\t${0}",
			"} while (${1:condition})"
		],
		"description": "Do-while loop"
	},
	"Match Expression": {
		"prefix": "match",
		"body": [
			"match (${1:value}) {",
			"\t${2:pattern} => ${3:result},",
			"\t_ => ${4:default}",
			"}"
		],
		"description": "Match expression"
	},
	"Match with Guard": {
		"prefix": "matchguard",
		"body": [
			"match (${1:value}) {",
			"\t${2:pattern} if ${3:condition} => ${4:result},",
			"\t_ => ${5:default}",
			"}"
		],
		"description": "Match with guard clause"
	},
	"Struct Definition": {
		"prefix": "struct",
		"body": [
			"struct ${1:StructName} {",
			"\t${2:field}: ${3:type}",
			"}"
		],
		"description": "Define a struct"
	},
	"Generic Struct": {
		"prefix": "structg",
		"body": [
			"struct ${1:StructName}<${2:T}> {",
			"\tvalue: $2",
			"}"
		],
		"description": "Define a generic struct"
	},
	"Struct with Impl": {
		"prefix": "structimpl",
		"body": [
			"struct ${1:StructName} {",
			"\t${2:field}: ${3:type}",
			"}",
			"",
			"impl $1 {",
			"\tfunc ${4:method}() -> ${5:returnType} {",
			"\t\t${0}",
			"\t}",
			"}"
		],
		"description": "Struct with implementation"
	},
	"Enum Definition": {
		"prefix": "enum",
		"body": [
			"enum ${1:EnumName} {",
			"\t${2:Variant1},",
			"\t${3:Variant2}",
			"}"
		],
		"description": "Define an enum"
	},
	"Enum with Values": {
		"prefix": "enumval",
		"body": [
			"enum ${1:EnumName} {",
			"\t${2:Variant1}(${3:type}),",
			"\t${4:Variant2}(${5:type})",
			"}"
		],
		"description": "Enum with associated values"
	},
	"Trait Definition": {
		"prefix": "trait",
		"body": [
			"trait ${1:TraitName} {",
			"\tfunc ${2:method}() -> ${3:returnType};",
			"}"
		],
		"description": "Define a trait"
	},
	"Trait Implementation": {
		"prefix": "traitmpl",
		"body": [
			"impl ${1:TraitName} for ${2:StructName} {",
			"\tfunc ${3:method}() -> ${4:returnType} {",
			"\t\t${0}",
			"\t}",
			"}"
		],
		"description": "Implement a trait for a struct"
	},
	"Lambda Function": {
		"prefix": "lambda",
		"body": "func(${1:params}) { ${0:return} }",
		"description": "Lambda/anonymous function"
	},
	"Try-Catch": {
		"prefix": "trycatch",
		"body": [
			"try {",
			"\t${1}",
			"} catch ${2:error} {",
			"\t${0}",
			"}"
		],
		"description": "Try-catch block"
	},
	"Result Type Function": {
		"prefix": "funcresult",
		"body": [
			"func ${1:functionName}(${2:params}) -> Result<${3:T}, ${4:E}> {",
			"\t${0}",
			"}"
		],
		"description": "Function returning Result type"
	},
	"Option Type Function": {
		"prefix": "funcoption",
		"body": [
			"func ${1:functionName}(${2:params}) -> Option<${3:T}> {",
			"\t${0}",
			"}"
		],
		"description": "Function returning Option type"
	},
	"Let Variable": {
		"prefix": "let",
		"body": "let ${1:varName} = ${0:value}",
		"description": "Define a variable"
	},
	"Const Variable": {
		"prefix": "const",
		"body": "const ${1:constName} = ${0:value}",
		"description": "Define a constant"
	},
	"Type Alias": {
		"prefix": "typealias",
		"body": "type ${1:TypeName} = ${0:ExistingType}",
		"description": "Create a type alias"
	},
	"Import Module": {
		"prefix": "import",
		"body": "import \"${1:module}\" as ${2:alias}",
		"description": "Import a module"
	},
	"Import Items": {
		"prefix": "importfrom",
		"body": "import ${1:Name} from \"${2:module}\"",
		"description": "Import an item from a module"
	},
	"Export": {
		"prefix": "export",
		"body": "export ${1:Name}",
		"description": "Export an item"
	},
	"Array Map": {
		"prefix": "map",
		"body": "map(${1:array}, func(${2:x}) { ${0} })",
		"description": "Map over array"
	},
	"Array Filter": {
		"prefix": "filter",
		"body": "filter(${1:array}, func(${2:x}) { ${0} })",
		"description": "Filter array"
	},
	"Array Reduce": {
		"prefix": "reduce",
		"body": "reduce(${1:array}, ${2:initial}, func(${3:acc}, ${4:x}) { ${0} })",
		"description": "Reduce array"
	},
	"Destructuring": {
		"prefix": "destruct",
		"body": "let (${1:a}, ${2:b}) = ${0:tuple}",
		"description": "Destructure tuple"
	},
	"Print": {
		"prefix": "print",
		"body": "print(${0})",
		"description": "Print to console"
	},
	"Print Line": {
		"prefix": "println",
		"body": "print(\"${0}\")",
		"description": "Print line to console"
	},
	"Macro Invocation": {
		"prefix": "macro",
		"body": "${1:macroName}!(${0:args})",
		"description": "Invoke a macro"
	},
	"Attribute": {
		"prefix": "attr",
		"body": "#[${1:attributeName}]",
		"description": "Apply attribute"
	},
	"Closure": {
		"prefix": "closure",
		"body": [
			"let ${1:name} = func(${2:params}) {",
			"\t${0}",
			"}"
		],
		"description": "Define a closure"
	},
	"Higher-Order Function": {
		"prefix": "hof",
		"body": [
			"func ${1:name}(f: (${2:T}) -> ${3:U}, ${4:value}: ${2:T}) -> ${3:U} {",
			"\treturn f(${4:value})",
			"}"
		],
		"description": "Higher-order function template"
	},
	"Throw": {
		"prefix": "throw",
		"body": "throw ${1:error}",
		"description": "Throw an error"
	},
	"Defer": {
		"prefix": "defer",
		"body": [
			"defer {",
			"\t${0}",
			"}"
		],
		"description": "Defer execution until function exit"
	}
}
