{
  "name": "kode",
  "displayName": "Kode",
  "description": "Language support for the Kode programming language — syntax highlighting, snippets, bracket matching, folding, and smart indentation.",
  "version": "0.1.5",
  "publisher": "ecocee",
  "icon": "icons/logo.png",
  "author": {
    "name": "Ecocee"
  },
  "license": "MIT",
  "homepage": "https://github.com/ecocee/kode",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecocee/kode.git"
  },
  "bugs": {
    "url": "https://github.com/ecocee/kode/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "kode",
    "programming",
    "language",
    "syntax",
    "systems"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kode",
        "aliases": [
          "Kode"
        ],
        "extensions": [
          ".kode",
          ".kbc"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "#!/usr/bin/env kode",
        "icon": {
          "light": "./icons/kode-language-icon.svg",
          "dark": "./icons/kode-language-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kode",
        "scopeName": "source.kode",
        "path": "./syntaxes/kode.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kode",
        "path": "./snippets/kode.json"
      }
    ],
    "iconThemes": [
      {
        "id": "kode-icons",
        "label": "Kode Icons",
        "path": "./icons/file-icons.json"
      }
    ],
    "themes": [
      {
        "id": "kode-style",
        "label": "Kode Style",
        "uiTheme": "vs-dark",
        "path": "./themes/kode-style.json"
      }
    ]
  },
  "scripts": {
    "test": "node ./test/index.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0"
  }
}
