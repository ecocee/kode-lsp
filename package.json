{
  "name": "kode",
  "displayName": "Kode Language",
  "description": "Professional language support for Kode - modern, fast, and expressive programming language with syntax highlighting, snippets, and advanced features",
  "version": "0.1.0",
  "publisher": "kode-lang",
  "author": {
    "name": "Ecocee",
    "email": "info@ecocee.in",
    "url": "https://ecocee.in",
    "github": "https://github.com/ecocee"
  },
  "license": "MIT",
  "icon": "icons/icon128.svg",
  "galleryBanner": {
    "color": "#7c3aed",
    "theme": "dark"
  },
  "homepage": "https://github.com/ecocee/kode-lsp",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecocee/kode-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/ecocee/kode-lsp/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "kode",
    "programming",
    "language",
    "syntax",
    "modern",
    "systems",
    "concurrency",
    "functional"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kode",
        "aliases": [
          "Kode",
          "kode"
        ],
        "extensions": [
          ".kode",
          ".kbc"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^#!/usr/bin/env kode",
        "icon": {
          "light": "./icons/kode-language-icon.svg",
          "dark": "./icons/kode-language-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kode",
        "scopeName": "app.kode",
        "path": "./syntaxes/kode.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kode",
        "path": "./snippets/kode.json"
      }
    ],
    "iconThemes": [
      {
        "id": "kode-icons",
        "label": "Kode Icons",
        "path": "./icons/file-icons.json"
      }
    ],
    "themes": [
      {
        "id": "kode-style",
        "label": "Kode Style",
        "uiTheme": "vs-dark",
        "path": "./themes/kode-style.json"
      }
    ]
  },
  "scripts": {
    "test": "node ./test/index.js"
  }
}
