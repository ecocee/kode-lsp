{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Kode",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#attributes"
		},
		{
			"include": "#type-annotations"
		},
		{
			"include": "#generics"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#types"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.kode",
					"match": "//.*$"
				},
				{
					"name": "comment.block.kode",
					"begin": "/\\*",
					"end": "\\*/",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.begin.kode"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.comment.end.kode"
						}
					}
				},
				{
					"name": "comment.line.documentation.kode",
					"match": "///.*$"
				}
			]
		},
		"attributes": {
			"patterns": [
				{
					"name": "meta.attribute.kode",
					"match": "#\\[([a-zA-Z_][a-zA-Z0-9_]*)\\]"
				},
				{
					"name": "meta.decorator.kode",
					"match": "@([a-zA-Z_][a-zA-Z0-9_]*)"
				}
			]
		},
		"type-annotations": {
			"patterns": [
				{
					"name": "storage.type.annotation.kode",
					"match": ":\\s*([a-zA-Z_][a-zA-Z0-9_]*|\\[|\\()"
				},
				{
					"name": "storage.type.generic.kode",
					"begin": "<",
					"end": ">",
					"patterns": [
						{
							"name": "entity.name.type.kode",
							"match": "[a-zA-Z_][a-zA-Z0-9_]*"
						}
					]
				},
				{
					"name": "storage.type.function.return.kode",
					"match": "->\\s*([a-zA-Z_][a-zA-Z0-9_]*|\\[|\\()"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.kode",
					"match": "\\b(if|else if|else|while|for|do|break|continue|return|match|yield)\\b"
				},
				{
					"name": "keyword.declaration.kode",
					"match": "\\b(func|let|const|struct|enum|trait|impl|import|export|from|pub|priv|internal|protected)\\b"
				},
				{
					"name": "keyword.control.async.kode",
					"match": "\\b(async|await|defer|yield|async func)\\b"
				},
				{
					"name": "keyword.control.flow.kode",
					"match": "\\b(spawn|send|receive|select|lock|unlock|make|goto|switch|case|default)\\b"
				},
				{
					"name": "keyword.operator.logical.kode",
					"match": "\\b(and|or|not|true|false|null|undefined)\\b"
				},
				{
					"name": "keyword.operator.type.kode",
					"match": "\\b(type|alias|typeof|as|is|in)\\b"
				},
				{
					"name": "keyword.exception.kode",
					"match": "\\b(try|catch|throws|throw|finally|panic)\\b"
				},
				{
					"name": "keyword.other.kode",
					"match": "\\b(where|bound|static|self|super|this|new|delete|sizeof|alignof)\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.kode",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.kode",
							"match": "\\\\[\\\\\"nrtbfv0]"
						},
						{
							"name": "constant.character.escape.unicode.kode",
							"match": "\\\\u\\{[0-9a-fA-F]+\\}"
						},
						{
							"name": "variable.interpolation.kode",
							"begin": "\\$\\{",
							"end": "\\}",
							"patterns": [
								{
									"include": "#keywords"
								},
								{
									"include": "#numbers"
								},
								{
									"include": "#operators"
								}
							]
						}
					]
				},
				{
					"name": "string.quoted.single.kode",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.kode",
							"match": "\\\\[\\\\']"
						}
					]
				},
				{
					"name": "string.template.kode",
					"begin": "`",
					"end": "`",
					"patterns": [
						{
							"name": "constant.character.escape.kode",
							"match": "\\\\."
						},
						{
							"name": "variable.interpolation.kode",
							"begin": "\\$\\{",
							"end": "\\}",
							"patterns": [
								{
									"include": "#keywords"
								}
							]
						}
					]
				},
				{
					"name": "string.regex.kode",
					"begin": "r\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.kode",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.kode",
					"match": "\\b0[xX][0-9a-fA-F]+[uUlL]*\\b"
				},
				{
					"name": "constant.numeric.binary.kode",
					"match": "\\b0[bB][01]+[uUlL]*\\b"
				},
				{
					"name": "constant.numeric.octal.kode",
					"match": "\\b0[oO][0-7]+[uUlL]*\\b"
				},
				{
					"name": "constant.numeric.float.kode",
					"match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?([fFdD])?\\b"
				},
				{
					"name": "constant.numeric.integer.kode",
					"match": "\\b\\d+[uUlL]*\\b"
				}
			]
		},
		"generics": {
			"patterns": [
				{
					"name": "meta.generic.kode",
					"begin": "<",
					"end": ">",
					"patterns": [
						{
							"include": "#types"
						},
						{
							"include": "#generics"
						},
						{
							"include": "#operators"
						},
						{
							"name": "keyword.operator.generic.kode",
							"match": ","
						}
					]
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.kode",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\<.*\\s*\\(|\\()",
					"captures": {
						"1": {
							"name": "entity.name.function.kode"
						}
					}
				},
				{
					"name": "entity.name.method.kode",
					"match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
				},
				{
					"name": "entity.name.macro.kode",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)!"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.range.kode",
					"match": "(\\.\\.=|\\.\\.|::)"
				},
				{
					"name": "keyword.operator.arrow.kode",
					"match": "(->|=>|<-)"
				},
				{
					"name": "keyword.operator.arithmetic.kode",
					"match": "[+\\-*/%^]"
				},
				{
					"name": "keyword.operator.comparison.kode",
					"match": "(==|!=|<=|>=|<|>)"
				},
				{
					"name": "keyword.operator.logical.kode",
					"match": "(&&|\\|\\||!|and|or|not)"
				},
				{
					"name": "keyword.operator.bitwise.kode",
					"match": "(&|\\||\\^|~|<<|>>)"
				},
				{
					"name": "keyword.operator.assignment.kode",
					"match": "(=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
				},
				{
					"name": "keyword.operator.pointer.kode",
					"match": "(&|\\*|\\?)"
				},
				{
					"name": "punctuation.separator.kode",
					"match": "[;,.]"
				},
				{
					"name": "punctuation.bracket.kode",
					"match": "[()\\[\\]{}]"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.kode",
					"match": "\\b(true|false|null|void|undefined|NaN|Infinity)\\b"
				},
				{
					"name": "variable.language.kode",
					"match": "\\b(this|self|super|Self)\\b"
				},
				{
					"name": "constant.other.result.kode",
					"match": "\\b(Result|Option|Some|None|Ok|Err)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.primitive.kode",
					"match": "\\b(int|i8|i16|i32|i64|uint|u8|u16|u32|u64|float|f32|f64|bool|string|char|byte|any|auto)\\b"
				},
				{
					"name": "storage.type.kode",
					"match": "\\b(void|never|dynamic|static|const)\\b"
				},
				{
					"name": "entity.name.type.class.kode",
					"match": "\\b([A-Z][a-zA-Z0-9_]*)\\b"
				},
				{
					"name": "storage.modifier.type.kode",
					"match": "\\b(mut|ref|ptr|&)\\b"
				}
			]
		}
	},
	"scopeName": "source.kode"
}