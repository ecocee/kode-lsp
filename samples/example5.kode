// Real-World Example: Social Media Post Comment System
// Manage posts, comments, likes, and user interactions

struct Comment {
    author: String,
    content: String,
    likes: Int
}

struct Post {
    postId: String,
    author: String,
    content: String,
    likes: Int,
    comments: [Comment]
}

func addComment(post: Post, author: String, content: String) -> Post {
    let newComment = Comment { author: author, content: content, likes: 0 };
    post.comments = post.comments + [newComment];
    print(author + " commented on the post");
    return post;
}

func likePost(post: Post) -> Post {
    post.likes = post.likes + 1;
    return post;
}

func likeComment(post: Post, commentIndex: Int) -> Post {
    post.comments[commentIndex].likes = post.comments[commentIndex].likes + 1;
    return post;
}

func displayPost(post: Post) {
    print("\n=== POST ===");
    print("Author: " + post.author);
    print("Content: " + post.content);
    print("Likes: " + post.likes);
    print("\nComments (" + post.comments.length + ")");
    
    for comment in post.comments {
        print("  - " + comment.author + ": " + comment.content + " (" + comment.likes + " likes)");
    }
}

func main() {
    let post = Post {
        postId: "POST_001",
        author: "Tech News Daily",
        content: "Excited to announce Kode language v2.0 with amazing features!",
        likes: 0,
        comments: []
    };
    
    post = likePost(post);
    post = likePost(post);
    post = likePost(post);
    
    post = addComment(post, "Alice Dev", "This looks amazing!");
    post = addComment(post, "Bob Coder", "Can't wait to try it!");
    post = addComment(post, "Carol Engineer", "Best update ever!");
    
    post = likeComment(post, 0);
    post = likeComment(post, 0);
    post = likeComment(post, 1);
    
    displayPost(post);
}

main();
